{
  "name": "cromodex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose --env-file .env.local up --build -d",
    "docker:down": "docker compose --env-file .env.local down",
    "local:start": "supabase start",
    "local:stop": "supabase stop",
    "local:migrate": "bash -c \". scripts/local-env.sh && drizzle-kit migrate\"",
    "local:seed": "bash -c \". scripts/local-env.sh && node scripts/seed-local.mjs\"",
    "local:dev": "bash -c \". scripts/local-env.sh && next dev\"",
    "local:check": "bash -c \". scripts/local-env.sh && tsx --conditions=react-server scripts/check-trading.ts && tsx --conditions=react-server scripts/check-notifications.ts && tsx --conditions=react-server scripts/check-telegram.ts\"",
    "telegram:webhook": "bash -c \"set -a && . ./.env.local && set +a && tsx --conditions=react-server scripts/telegram-webhook.ts\"",
    "telegram:poll": "bash -c \". scripts/local-env.sh && tsx --conditions=react-server scripts/telegram-poll.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
