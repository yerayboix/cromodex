# Copy to .env.local and fill in. Never commit real values.

# Supabase project base URL (without /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — Auth only, browser-safe
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only (user admin)
SUPABASE_SECRET_KEY=

# Session pooler (port 5432) — used by the app. Not the transaction pooler
# (6543): it hangs on the pipelined queries postgres.js sends.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Session pooler (port 5432) — used by drizzle-kit for migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
