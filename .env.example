# Copy to .env.local and fill in. Never commit real values.

# Supabase project base URL (without /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — Auth only, browser-safe
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only (user admin)
SUPABASE_SECRET_KEY=

# Session pooler (port 5432) — used by the app. Not the transaction pooler
# (6543): it hangs on the pipelined queries postgres.js sends.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Session pooler (port 5432) — used by drizzle-kit for migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Public URL of the app, used for links in notifications.
APP_URL=https://cromodex.duckdns.org
# Notifications to the server log: on by default in development; 1 forces it.
# NOTIFICATIONS_CONSOLE=0

# Notifications (docs/notifications.md). A channel is on when its vars are set.
# Telegram bot from @BotFather; username without @; webhook secret: random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Bearer secret of POST /api/notifications/dispatch (scheduled job).
NOTIFICATIONS_CRON_SECRET=
